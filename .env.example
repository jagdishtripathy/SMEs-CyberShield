# ============================================================================
# CYBERSECURITY SIEM + USER DASHBOARD - ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================================
# This is an EXAMPLE configuration file. NEVER share your real .env file!
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys and credentials in .env
# 3. Add .env to .gitignore to prevent accidental exposure
# 4. Keep .env.example in version control as documentation
# ============================================================================

# ============================================================================
# GOOGLE GEMINI API KEY (REQUIRED)
# ============================================================================
# Get your free API key from: https://ai.google.dev
# This is used for AI-powered recommendations and chatbot functionality
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# ELASTICSEARCH CONFIGURATION (REQUIRED for SIEM features)
# ============================================================================
# Elasticsearch host and port
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# Elasticsearch authentication credentials
# Default username is "elastic"
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password_here

# ============================================================================
# FLASK APPLICATION SETTINGS
# ============================================================================
# Flask secret key for session management
# If left empty, a new key will be generated each time the app starts
FLASK_SECRET_KEY=your_secret_key_here_or_leave_empty

# Flask environment
FLASK_ENV=development

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Debug mode (set to False in production)
DEBUG=True

# ============================================================================
# FILE PATHS (Linux/Unix systems)
# ============================================================================
# Auth log file path (for log collection)
AUTH_LOG_FILE=/var/log/auth.log

# Suricata EVE JSON log file path (for threat detection)
SURICATA_EVE_LOG_FILE=/var/log/suricata/eve.json

# PDF save path for report generation
PDF_SAVE_PATH=/tmp/save_reports

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Install python-dotenv if not already installed:
#    pip install python-dotenv
#
# 2. Create your .env file from this example:
#    cp .env.example .env
#
# 3. Edit .env and fill in your actual credentials:
#    - Get GEMINI_API_KEY from https://ai.google.dev
#    - Get ELASTICSEARCH credentials from your Elasticsearch setup
#    - Update file paths if different on your system
#
# 4. Make sure .env is in your .gitignore:
#    echo ".env" >> .gitignore
#
# 5. Keep .env.example in version control for reference
# ============================================================================
